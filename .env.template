# Humboldt Environment Variables
# Copy to .env and fill from ../protocol-institute/.env.keys. Never commit .env.
# Keys registered in ../admin/keys.md.
# After creating .env: xattr -w com.dropbox.ignored 1 .env

# ── Retrieval: Direct Pinecone access (primary) ────────────────────────────
VOYAGE_API_KEY=
PINECONE_API_KEY=
PINECONE_C3PO_HOST=          # host URL of the c3po Pinecone index

# ── Synthesis: Anthropic Claude ────────────────────────────────────────────
ANTHROPIC_API_KEY=

# ── Retrieval: C3PO Worker API (secondary — optional) ──────────────────────
C3PO_WORKER_URL=             # e.g. https://c3po.protocolized.io
C3PO_MCP_KEY=                # MCP_API_KEY from c3po worker (if using MCP endpoint)

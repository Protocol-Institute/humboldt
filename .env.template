# Humboldt Environment Variables
# Copy to .env and fill from ../protocol-institute/.env.keys. Never commit .env.
# Keys registered in ../admin/keys.md.
# After creating .env: xattr -w com.dropbox.ignored 1 .env

# ── Retrieval: Direct Pinecone access (primary) ────────────────────────────
VOYAGE_API_KEY=
PINECONE_API_KEY=
PINECONE_C3PO_HOST=          # host URL of the c3po Pinecone index

# ── Synthesis: Anthropic Claude ────────────────────────────────────────────
ANTHROPIC_API_KEY=

# ── Retrieval: C3PO Worker API (secondary — optional) ──────────────────────
C3PO_WORKER_URL=             # e.g. https://c3po.protocolized.io
C3PO_MCP_KEY=                # MCP_API_KEY from c3po worker (if using MCP endpoint)

# ── Discord (Humboldt bot) ──────────────────────────────────────────────────
DISCORD_BOT_TOKEN=           # Discord Developer Portal → Bot → Reset Token
DISCORD_APPLICATION_ID=      # Discord Developer Portal → General Information
DISCORD_PUBLIC_KEY=          # Discord Developer Portal → General Information
DISCORD_GUILD_ID=            # PI Discord server ID (right-click server name → Copy Server ID)
DISCORD_NEW_NATURE_CHANNEL_ID=  # #new-nature channel ID (right-click → Copy Channel ID)
DISCORD_OPERATOR_USER_ID=    # your Discord user ID (Developer Mode → right-click username)
